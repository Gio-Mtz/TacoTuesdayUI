{
  "name": "taco-tuesday-ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "postbuild": "node tools/emit-route-cards.mjs",
    "check:contrast": "node tools/check-contrast.mjs",
    "check:fontsize": "node tools/check-font-sizes.mjs",
    "check:routes": "node tools/check-route-config.mjs",
    "check:hreflang": "node tools/check-hreflang.mjs",
    "format": "prettier --write .",
    "check:format": "prettier --check .",
    "watch": "ng build --watch --configuration development",
    "serve:dist": "node tools/serve-dist.mjs",
    "test": "ng test",
    "check:audit": "npm audit --audit-level=critical",
    "check:nodeengine": "node tools/check-node-engine.mjs",
    "check:swa": "node tools/check-swa-pr-symmetry.mjs"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/common": "^21.2.25",
    "@angular/compiler": "^21.2.25",
    "@angular/core": "^21.2.25",
    "@angular/forms": "^21.2.25",
    "@angular/platform-browser": "^21.2.25",
    "@angular/router": "^21.2.25",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.26",
    "@angular/cli": "^21.2.15",
    "@angular/compiler-cli": "^21.2.25",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "semver": "^7.8.5",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  },
  "overrides": {
    "piscina": "5.3.2",
    "undici": "7.29.1"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
